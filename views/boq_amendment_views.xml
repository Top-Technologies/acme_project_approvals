<odoo>
    <record id="boq_amendment_wizard_form" model="ir.ui.view">
        <field name="name">acme.boq.amendment.wizard.form</field>
        <field name="model">acme.boq.amendment.wizard</field>
        <field name="arch" type="xml">
            <form string="Edit BOQ">
                <group>
                    <field name="project_id"/>
                    <field name="reason" required="1"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="boq_id" readonly="1"/>
                        <field name="current_quantity" readonly="1"/>
                        <field name="proposed_quantity"/>
                    </list>
                </field>
                <footer>
                    <button name="action_submit" type="object" string="Submit Amendment" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
